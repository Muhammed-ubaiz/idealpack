# ── Ideal Pack AI server ─────────────────────────────────────────────
# Copy this file to `.env` and fill in ONE provider's key.
# `.env` is git-ignored — never commit real keys, never ship them to the browser.

# Port the API listens on (the Vite dev proxy points here by default).
PORT=8787

# Comma-separated list of browser origins allowed to call this API.
# Dev example below; add your production site origin for deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Which provider to use: "openai" or "gemini".
AI_PROVIDER=openai

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini (used only when AI_PROVIDER=gemini) ────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
